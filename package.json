{
  "name": "dentiva-pro",
  "productName": "Dentiva Pro",
  "version": "1.0.0",
  "description": "Dentiva Pro - Premium offline-first dental clinic management for Windows",
  "author": "Dentiva",
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true});require('node:fs').rmSync('release',{recursive:true,force:true})\"",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron --no-sandbox .",
    "start": "electron --no-sandbox .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf": "vitest run --config vitest.perf.config.ts",
    "pack": "node scripts/build.mjs && node scripts/pack.mjs",
    "preview": "node scripts/build.mjs && node scripts/preview-server.mjs"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "better-sqlite3": "13.0.3",
    "pdfkit": "0.20.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.4",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "pdf-parse": "2.4.5",
    "typescript": "^5.9.2",
    "vitest": "5.0.2"
  }
}
